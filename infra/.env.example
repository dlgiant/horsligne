# Hors Ligne backend env — copy to /etc/horsligne/env on the server (chmod 600).
# Never commit real values. Generate secrets per infra/secrets.md.

# --- server ---
PORT=3000
# JSONL store location (append-only). Set DATABASE_URL to use Postgres instead
# (backend/src/pgbackend.js: kv table, per-request flush, hydration on boot).
# Migrate existing JSONL: DATA_DIR=… DATABASE_URL=… node backend/scripts/migrate-jsonl-to-pg.mjs
DATA_DIR=/srv/horsligne/backend/data
# DATABASE_URL=postgres://horsligne:***@db.internal:5432/horsligne
# PG_SCHEMA=hl_prod        # optional; default hl_<hash8(DATA_DIR)>
# Static dir served by the backend itself; in prod nginx serves statics, so:
PUBLIC_DIR=none

# --- secrets (REQUIRED in prod — see infra/secrets.md) ---
# Bearer token for admin/staff routes and the admin console.
ADMIN_TOKEN=
# HMAC secret for portal + traveler session tokens (s1....). Rotate = all sessions die.
SESSION_SECRET=
# RevenueCat webhook signing secret (dashboard → webhooks). When set, unsigned
# webhooks are rejected with 401. Unset = dev only, unsigned accepted + audited.
REVENUECAT_WEBHOOK_SECRET=

# --- public URLs ---
# CORS allow-origin for the landing page calls.
LANDING_ORIGIN=https://horslign.earth
# Base used to build portal invite links (/p/<token>).
PORTAL_BASE_URL=https://portal.horslign.earth/#

# --- dev/demo only (NEVER in prod) ---
# "1" includes the OTP in API responses for demos.
OTP_DEV_REVEAL=0
